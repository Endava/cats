<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>Cats</title>
</head>
<body>
<div class="banner-component">
    <div class="flex-items-center">
        <img src="./assets/clock-wise.svg" alt="version">
        <span class="left">
				Generated with CATS {{VERSION}}
			</span>
    </div>
    <div class="flex-items-center">
        <img src="./assets/clock.svg" alt="timestamp">
        <span>
				{{TIMESTAMP}}
			</span>
    </div>
</div>
<header>
    <div class="logo">
        <img class="logo-white" src="./assets/cats-logo-dark.svg" alt="White Logo">
        {{#JS}}
        <img class="logo-dark" src="./assets/cats-logo-white.svg" alt="Dark Logo">
        {{/JS}}
    </div>
    {{#JS}}
    <div class="theme-toggle">
        <button id="theme-toggle" style="display: none;">
            <img class="theme-icon-light" src="./assets/white-mode-icon.svg" alt="Light Theme Icon">
            <img class="theme-icon-dark" src="./assets/dark-mode-icon.svg" alt="Dark Theme Icon">
        </button>
    </div>
    {{/JS}}
</header>
{{#TEST_CASE}}
<div class="page-body">
    <!-- T1 Refined: Unified Top Metadata Board (All 13 Original Fields Explicitly Preserved in a 2-Column Grid) -->
    <div class="t1-board">
        <div class="t1-board-header">
            <div class="t1-header-left">
                <a href="index.html" class="anchor-tag">All Tests</a>&nbsp;&nbsp;/&nbsp;&nbsp;<strong>{{testId}}</strong>
            </div>
            {{#hasRequestDetails}}
            <div class="t1-header-right">
                <span class="t1-replay-label">CATS Replay</span>
                <div class="t1-replay-pill" id="code-cats-replay">
                    <pre style="margin:0;display:inline;"><code>{{catsReplay}}</code></pre>
                </div>
                {{#js}}
                <button class="copy-button copy-button-cats-replay" onclick="copyCode('code-cats-replay', this)">Copy code</button>
                {{/js}}
            </div>
            {{/hasRequestDetails}}
        </div>

        <div class="t1-grid">
            <div class="t1-lbl">Test Id</div>
            <div class="t1-val"><strong>{{testId}}</strong></div>
            <div class="t1-lbl">Test Trace Id</div>
            <div class="t1-val t1-trace-cell">
                <code id="trace-id-val">{{traceId}}</code>
                {{#js}}
                <button type="button" class="inline-copy-btn" onclick="copyCode('trace-id-val', this)" title="Copy Trace ID">Copy</button>
                {{/js}}
            </div>

            <div class="t1-lbl">Result</div>
            <div class="t1-val"><label class="test-result result-{{result}}">{{result}}</label></div>
            <div class="t1-lbl">Expected Result</div>
            <div class="t1-val">{{expectedResult}}</div>

            <div class="t1-lbl">Fuzzer</div>
            <div class="t1-val"><strong>{{fuzzer}}</strong></div>
            <div class="t1-lbl">Timestamp</div>
            <div class="t1-val">{{request.timestamp}}</div>

            <div class="t1-lbl">Http Method</div>
            <div class="t1-val"><span class="active rounded rounded-{{httpMethod}} details">{{httpMethod}}</span></div>
            <div class="t1-lbl">Contract Path</div>
            <div class="t1-val"><span class="rounded path details" style="margin-left:0;">{{contractPath}}</span></div>

            <div class="t1-lbl">Full Request Path</div>
            <div class="t1-val span-3">
                <span class="rounded path details" style="margin-left:0;">{{fullRequestPath}}</span>
            </div>

            <div class="t1-lbl">Scenario</div>
            <div class="t1-val span-3">{{scenario}}</div>

            <div class="t1-lbl">Result Details</div>
            <div class="t1-val span-3">
                <div>{{{resultDetailsForHtml}}}</div>
            </div>

            {{#hasResultSwitched}}
            <div class="t1-lbl result-warn">Warning</div>
            <div class="t1-val span-3 result-warn">{{resultIgnoreDetails}}</div>
            {{/hasResultSwitched}}

            {{#hasMutationTargets}}
            <div class="t1-lbl">Mutation Targets</div>
            <div class="t1-val span-3">
                <div class="mutation-targets-list">
                {{#mutationTargets}}
                    <p class="mutation-target-row">{{locationName}} -&gt; {{name}}</p>
                {{/mutationTargets}}
                </div>
            </div>
            {{/hasMutationTargets}}
        </div>
    </div>

    {{#hasRequestDetails}}
    {{#js}}
    <!-- Side-by-Side Request Details & Response Workbench -->
    <div class="t1-pair">
        <div class="tabbed-section">
            <div class="tabs">
                <div class="tabs-and-title">
                    <div class="component section-title">Request Details</div>
                    <div class="all-tabs">
                        <div class="component tab active" onclick="showReportTab(this, 'request-payload')">Payload</div>
                        <div class="component tab" onclick="showReportTab(this, 'request-headers')">Headers</div>
                        <div class="component tab" onclick="showReportTab(this, 'request-curl')">cURL</div>
                    </div>
                </div>
                <button class="copy-button" onclick="copyActiveTab(this)">Copy code</button>
            </div>
            <div class="code-area active" id="request-payload">
                <pre><code>{{requestJson}}</code></pre>
            </div>
            <div class="code-area" id="request-headers">
                <pre><code>{{headers}}</code></pre>
            </div>
            <div class="code-area" id="request-curl">
                <pre><code>{{curl}}</code></pre>
            </div>
        </div>

        <div class="section-response tabbed-section" style="margin-top:0;margin-bottom:0;">
            <div class="tabs">
                <div class="tabs-and-title">
                    <div class="component section-title">Response</div>
                    <div class="all-tabs">
                        <div class="component tab active" onclick="showReportTab(this, 'response-body')">Body</div>
                        <div class="component tab" onclick="showReportTab(this, 'response-headers')">Headers</div>
                        <div class="component tab" onclick="showReportTab(this, 'response-details')">Details</div>
                    </div>
                </div>
                <button class="copy-button" onclick="copyActiveTab(this)">Copy code</button>
            </div>
            <div class="code-area active" id="response-body">
                <pre><code>{{responseBody}}</code></pre>
            </div>
            <div class="code-area" id="response-headers">
                <pre><code>{{responseHeaders}}</code></pre>
            </div>
            <div class="code-area" id="response-details">
                <div class="response-details-grid">
                    <div class="response-detail"><span>HTTP status</span><strong>{{response.responseCode}}</strong></div>
                    <div class="response-detail"><span>Response time</span><strong>{{response.responseTimeInMs}}ms</strong></div>
                    <div class="response-detail"><span>Content type</span><strong>{{response.responseContentType}}</strong></div>
                    <div class="response-detail"><span>Content length</span><strong>{{response.contentLengthInBytes}} bytes</strong></div>
                    {{#response.bodyTruncated}}
                    <div class="response-detail"><span>Body capture</span><strong>Truncated at {{response.capturedBodyBytes}} bytes</strong></div>
                    <div class="response-detail"><span>Declared length</span><strong>{{response.declaredContentLengthDisplay}}</strong></div>
                    {{/response.bodyTruncated}}
                    <div class="response-detail"><span>Words</span><strong>{{response.numberOfWordsInResponse}}</strong></div>
                    <div class="response-detail"><span>Lines</span><strong>{{response.numberOfLinesInResponse}}</strong></div>
                </div>
            </div>
        </div>
    </div>
    {{/js}}

    {{^js}}
    <div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">Payload</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{requestJson}}</code></pre>
        </div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">Headers</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{headers}}</code></pre>
        </div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">cURL</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{curl}}</code></pre>
        </div>
    </div>
    <div class="section-response">
        <div class="tabs-header">
            <div class="component section-title">Response Body</div>
        </div>
        <div class="code-area-outside">
            <pre><code>{{responseBody}}</code></pre>
        </div>
        <div class="tabs-header stacked-response-section">
            <div class="component section-title">Response Headers</div>
        </div>
        <div class="code-area-outside">
            <pre><code>{{responseHeaders}}</code></pre>
        </div>
        <div class="tabs-header stacked-response-section">
            <div class="component section-title">Response Details</div>
        </div>
        <div class="code-area-outside">
            <div class="response-details-grid">
                <div class="response-detail"><span>HTTP status</span><strong>{{response.responseCode}}</strong></div>
                <div class="response-detail"><span>Response time</span><strong>{{response.responseTimeInMs}}ms</strong></div>
                <div class="response-detail"><span>Content type</span><strong>{{response.responseContentType}}</strong></div>
                <div class="response-detail"><span>Content length</span><strong>{{response.contentLengthInBytes}} bytes</strong></div>
                {{#response.bodyTruncated}}
                <div class="response-detail"><span>Body capture</span><strong>Truncated at {{response.capturedBodyBytes}} bytes</strong></div>
                <div class="response-detail"><span>Declared length</span><strong>{{response.declaredContentLengthDisplay}}</strong></div>
                {{/response.bodyTruncated}}
                <div class="response-detail"><span>Words</span><strong>{{response.numberOfWordsInResponse}}</strong></div>
                <div class="response-detail"><span>Lines</span><strong>{{response.numberOfLinesInResponse}}</strong></div>
            </div>
        </div>
    </div>
    {{/js}}
    {{/hasRequestDetails}}

    {{#hasRuntimeCorrelations}}
    <div class="section-response" style="margin-top: 16px;">
        <div class="tabs-header">
            <div class="component section-title">Runtime Correlations</div>
        </div>
        <div class="code-area-outside">
            <table class="runtime-correlations-table">
                <thead>
                <tr class="header">
                    <th>Source operation</th>
                    <th>Source location</th>
                    <th>Target</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                {{#runtimeCorrelations}}
                <tr class="runtime-correlation-row">
                    <td>{{sourceMethod}} {{sourcePath}}</td>
                    <td>{{sourceLocation}}</td>
                    <td>{{targetLocation}} {{targetField}}</td>
                    <td>{{value}}</td>
                </tr>
                {{/runtimeCorrelations}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasRuntimeCorrelations}}
</div>
{{/TEST_CASE}}
{{#JS}}
<script src="script.js"></script>
{{/JS}}
</body>
</html>
