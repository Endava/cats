<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;800&display=swap" rel="stylesheet">
    <title>Cats</title>
</head>
<body>
<div class="banner-component">
    <div class="flex-items-center">
        <img src="./assets/clock-wise.svg" alt="version">
        <span class="left">
				Generated with CATS {{VERSION}}
			</span>
    </div>
    <div class="flex-items-center">
        <img src="./assets/clock.svg" alt="timestamp">
        <span>
				{{TIMESTAMP}}
			</span>
    </div>
</div>
<header>
    <div class="logo">
        <img class="logo-white" src="./assets/cats-logo-dark.svg" alt="White Logo">
        {{#JS}}
        <img class="logo-dark" src="./assets/cats-logo-white.svg" alt="Dark Logo">
        {{/JS}}
    </div>
    {{#JS}}
    <div class="theme-toggle">
        <button id="theme-toggle"  style="display: none;">
            <img class="theme-icon-light" src="./assets/white-mode-icon.svg" alt="Light Theme Icon">
            <img class="theme-icon-dark" src="./assets/dark-mode-icon.svg" alt="Dark Theme Icon">
        </button>
    </div>
    {{/JS}}
</header>
{{#TEST_CASE}}
<div class="page-body">
    <div class="page-container page-text">
        <a href="index.html" class="anchor-tag">All Tests</a>&nbsp&nbsp/&nbsp&nbsp{{testId}}
    </div>

    <div class="table-container">
        <div class="component title border-left-top">
            <p>Test Id</p>
        </div>
        <div class="component text border-right-top">
            <p>{{testId}}</p>
        </div>

        <div class="component title border-left-top">
            <p>Test Trace Id</p>
        </div>
        <div class="component text border-right-top">
            <p>{{traceId}}</p>
        </div>

        <div class="component title">
            <p>Timestamp</p>
        </div>
        <div class="component text">
            <p>{{request.timestamp}}</p>
        </div>

        <div class="component title">
            <p>Scenario</p>
        </div>
        <div class="component text">
            <p>{{scenario}}</p>
        </div>
        <div class="component title">
            <p>Expected Result</p>
        </div>
        <div class="component text">
            <p>{{expectedResult}}</p>
        </div>
        <div class="component title">
            <p>Result</p>
        </div>
        <div class="component text">
            <label class="test-result result-{{result}}">{{result}}</label>
        </div>
        <div class="component title">
            <p>Result Details</p>
        </div>
        <div class="component text">
            <p>
                {{{resultDetailsForHtml}}}
            </p>
        </div>
        {{#hasResultSwitched}}
            <div class="component title result-warn">
                <p>Warning</p>
            </div>
            <div class="component text result-warn">
                <p>
                    {{resultIgnoreDetails}}
                </p>
            </div>
        {{/hasResultSwitched}}
        <div class="component title">
            <p>Contract Path</p>
        </div>
        <div class="component text">
            <span class="rounded path details">{{contractPath}}</span>
        </div>

        <div class="component title">
            <p>Fuzzer</p>
        </div>
        <div class="component text">
            <p>{{fuzzer}}</p>
        </div>

        {{#hasMutationTargets}}
        <div class="component title">
            <p>Mutation Targets</p>
        </div>
        <div class="component text">
            <div class="mutation-targets-list">
            {{#mutationTargets}}
                <p class="mutation-target-row">{{locationName}} -&gt; {{name}}</p>
            {{/mutationTargets}}
            </div>
        </div>
        {{/hasMutationTargets}}

        <div class="component title">
            <p>Full Request Path</p>
        </div>
        <div class="component text">
            <span class="rounded path details">{{fullRequestPath}}</span>
        </div>

        <div class="component title border-left-bottom">
            <p>Http Method</p>
        </div>
        <div class="component text border-right-bottom">
            <span class="active rounded rounded-{{httpMethod}} details">{{httpMethod}}</span>
        </div>
        <div class="clearfix"></div>
    </div>
    {{#hasRequestDetails}}
    {{#js}}
    <div class="tabbed-section">
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active" onclick="showReportTab(this, 'request-payload')">Payload</div>
                    <div class="component tab" onclick="showReportTab(this, 'request-headers')">Headers</div>
                    <div class="component tab" onclick="showReportTab(this, 'request-curl')">cURL</div>
                </div>
            </div>
            <button class="copy-button" onclick="copyActiveTab(this)">Copy code</button>
        </div>
        <div class="code-area active" id="request-payload">
            <pre><code>{{requestJson}}</code></pre>
        </div>

        <div class="code-area" id="request-headers">
            <pre><code>{{headers}}</code></pre>
        </div>

        <div class="code-area" id="request-curl">
            <pre><code>{{curl}}</code></pre>
        </div>
    </div>
    {{/js}}

    {{^js}}
    <div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">Payload</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{requestJson}}</code></pre>
        </div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">Headers</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{headers}}</code></pre>
        </div>
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Request Details</div>
                <div class="all-tabs">
                    <div class="component tab active">cURL</div>
                </div>
            </div>
        </div>
        <div class="code-area active">
            <pre><code>{{curl}}</code></pre>
        </div>
    </div>
    {{/js}}
    {{#js}}
    <div class="section-response tabbed-section">
        <div class="tabs">
            <div class="tabs-and-title">
                <div class="component section-title">Response</div>
                <div class="all-tabs">
                    <div class="component tab active" onclick="showReportTab(this, 'response-body')">Body</div>
                    <div class="component tab" onclick="showReportTab(this, 'response-headers')">Headers</div>
                    <div class="component tab" onclick="showReportTab(this, 'response-details')">Details</div>
                </div>
            </div>
            <button class="copy-button" onclick="copyActiveTab(this)">Copy code</button>
        </div>
        <div class="code-area active" id="response-body">
            <pre><code>{{responseBody}}</code></pre>
        </div>
        <div class="code-area" id="response-headers">
            <pre><code>{{responseHeaders}}</code></pre>
        </div>
        <div class="code-area" id="response-details">
            <div class="response-details-grid">
                <div class="response-detail"><span>HTTP status</span><strong>{{response.responseCode}}</strong></div>
                <div class="response-detail"><span>Response time</span><strong>{{response.responseTimeInMs}}ms</strong></div>
                <div class="response-detail"><span>Content type</span><strong>{{response.responseContentType}}</strong></div>
                <div class="response-detail"><span>Content length</span><strong>{{response.contentLengthInBytes}} bytes</strong></div>
                <div class="response-detail"><span>Words</span><strong>{{response.numberOfWordsInResponse}}</strong></div>
                <div class="response-detail"><span>Lines</span><strong>{{response.numberOfLinesInResponse}}</strong></div>
            </div>
        </div>
    </div>
    {{/js}}

    {{^js}}
    <div class="section-response">
        <div class="tabs-header">
            <div class="component section-title">Response Body</div>
        </div>
        <div class="code-area-outside">
            <pre><code>{{responseBody}}</code></pre>
        </div>
        <div class="tabs-header stacked-response-section">
            <div class="component section-title">Response Headers</div>
        </div>
        <div class="code-area-outside">
            <pre><code>{{responseHeaders}}</code></pre>
        </div>
        <div class="tabs-header stacked-response-section">
            <div class="component section-title">Response Details</div>
        </div>
        <div class="code-area-outside">
            <div class="response-details-grid">
                <div class="response-detail"><span>HTTP status</span><strong>{{response.responseCode}}</strong></div>
                <div class="response-detail"><span>Response time</span><strong>{{response.responseTimeInMs}}ms</strong></div>
                <div class="response-detail"><span>Content type</span><strong>{{response.responseContentType}}</strong></div>
                <div class="response-detail"><span>Content length</span><strong>{{response.contentLengthInBytes}} bytes</strong></div>
                <div class="response-detail"><span>Words</span><strong>{{response.numberOfWordsInResponse}}</strong></div>
                <div class="response-detail"><span>Lines</span><strong>{{response.numberOfLinesInResponse}}</strong></div>
            </div>
        </div>
    </div>
    {{/js}}

    <div>
        <div class="tabs-header">
            <div class="component section-title">CATS Replay</div>
            {{#js}}
            <button class="copy-button copy-button-cats-replay" onclick="copyCode('code-cats-replay', this)">Copy code</button>
            {{/js}}
        </div>
        <div class="code-area-outside" id="code-cats-replay">
            <pre><code>{{catsReplay}}</code></pre>
        </div>
    </div>
{{/hasRequestDetails}}
{{#hasRuntimeCorrelations}}
    <div class="section-response">
        <div class="tabs-header">
            <div class="component section-title">Runtime Correlations</div>
        </div>
        <div class="code-area-outside">
            <table class="runtime-correlations-table">
                <thead>
                <tr class="header">
                    <th>Source operation</th>
                    <th>Source location</th>
                    <th>Target</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                {{#runtimeCorrelations}}
                <tr class="runtime-correlation-row">
                    <td>{{sourceMethod}} {{sourcePath}}</td>
                    <td>{{sourceLocation}}</td>
                    <td>{{targetLocation}} {{targetField}}</td>
                    <td>{{value}}</td>
                </tr>
                {{/runtimeCorrelations}}
                </tbody>
            </table>
        </div>
    </div>
{{/hasRuntimeCorrelations}}
</div>
{{/TEST_CASE}}
{{#JS}}
<script src="script.js"></script>
{{/JS}}
</body>

</html>
