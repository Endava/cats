<h2 class="title-section">Run Details</h2>
<div class="run-details-grid">
    <div class="card-wrapper">
        <h2 class="action-tag no-top">Run outcome</h2>
        <p class="report-status"><label class="test-result result-{{runStatusResult}}">{{runStatus}}</label></p>
        <p class="report-detail-note">{{runStatusDetails}}</p>
        <h2 class="action-tag">Quality gate</h2>
        <p class="report-status"><label class="test-result result-{{qualityGateResult}}">{{qualityGateStatus}}</label></p>
        <p class="report-detail-note">{{qualityGateDescription}}</p>
    </div>
    <div class="card-wrapper">
        <h2 class="action-tag no-top">Execution accounting</h2>
        <div class="report-detail-row"><span>Tests completed</span><strong>{{completedTests}}</strong></div>
        <div class="report-detail-row"><span>HTTP requests sent</span><strong>{{requestsAttempted}}</strong></div>
        {{#showResultsIncluded}}
        <div class="report-detail-row"><span>Results included in report</span><strong>{{reportedResults}}</strong></div>
        {{/showResultsIncluded}}
        <div class="report-detail-row"><span>Skipped tests (total)</span><strong>{{skipped}}</strong></div>
        {{#hasSkippedFromReporting}}
        <div class="report-detail-row"><span>Omitted by reporting rules</span><strong>{{skippedFromReporting}}</strong></div>
        {{/hasSkippedFromReporting}}
    </div>
    <div class="card-wrapper">
        <h2 class="action-tag no-top">Execution diagnostics</h2>
        <div class="report-detail-row"><span>Authentication errors</span><strong>{{authErrors}}</strong></div>
        <div class="report-detail-row"><span>I/O errors</span><strong>{{ioErrors}}</strong></div>
    </div>
    <div class="card-wrapper">
        <h2 class="action-tag no-top">Reproduction</h2>
        <div class="report-detail-row"><span>Random seed</span><strong>{{randomSeed}}</strong></div>
        <div class="report-detail-row"><span>Runtime resource reuse</span><strong>{{resourceReuseStatus}}</strong></div>
        {{#hasStopLimits}}
        <h2 class="action-tag">Configured stop limits</h2>
        {{#stopLimits}}
        <div class="report-detail-row"><span>{{name}}</span><strong>{{value}}{{suffix}}</strong></div>
        {{/stopLimits}}
        {{/hasStopLimits}}
        {{^hasStopLimits}}
        <div class="report-detail-row"><span>Stop limits</span><strong>None</strong></div>
        {{/hasStopLimits}}
    </div>
</div>
{{#hasProcessingErrors}}
<h2 class="title-section">Processing Limitations</h2>
<div class="card-wrapper">
    <p class="report-detail-note">These issues may have prevented some contract elements or fuzzing scenarios from being processed completely.</p>
    <table class="report-details-table">
        <thead>
        <tr class="header">
            <th>Operation</th>
            <th>Details</th>
        </tr>
        </thead>
        <tbody>
        {{#processingErrors}}
        <tr>
            <td>{{operation}}</td>
            <td>{{message}}</td>
        </tr>
        {{/processingErrors}}
        </tbody>
    </table>
</div>
{{/hasProcessingErrors}}
