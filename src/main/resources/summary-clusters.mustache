<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="stylesheet" href="styles.css"/>
    <link rel="stylesheet" href="styles-cluster.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;800&display=swap" rel="stylesheet">
    <script src="chart.js"></script>
    <script>
        const totalErr = parseInt('{{errors}}'.replace(/ /g, ''));
        const totalWrn = parseInt('{{warnings}}'.replace(/ /g, ''));
        const totalScs = parseInt('{{success}}'.replace(/ /g, ''));
    </script>
    <title>Cats</title>
</head>
<body>
<div class="banner-component">
    <div class="flex-items-center">
        <img src="./assets/clock-wise.svg" alt="version">
        <span class="left">
				Generated with CATS {{version}} on {{os}}
			</span>
    </div>
    <div class="flex-items-center">
        <img src="./assets/clock.svg" alt="timestamp">
        <span>
				{{timestamp}}
			</span>
    </div>
</div>
<header>
    <div class="logo">
        <img class="logo-white" src="./assets/cats-logo-dark.svg" alt="White Logo">
        {{#javascript}}
        <img class="logo-dark" src="./assets/cats-logo-white.svg" alt="Dark Logo">
        {{/javascript}}
    </div>
    <div class="theme-toggle">
        <button id="theme-toggle" style="display: none;">
            <img class="theme-icon-light" src="./assets/white-mode-icon.svg" alt="Light Theme Icon">
            <img class="theme-icon-dark" src="./assets/dark-mode-icon.svg" alt="Dark Theme Icon">
        </button>
    </div>
</header>
<main class="container">
    <!-- Row 1: S2-A Top-Aligned 3-Card Overview & Run Details -->
    <div class="row1-hybrid-grid">
        <div class="card-wrapper s2a-donut-card">
            <div class="s2a-card-top">
                <h2 class="action-tag no-top">Tests Reported</h2>
                <p class="big-number">{{testsReported}} tests</p>
            </div>
            {{#javascript}}
            <div class="chart-container s2a-donut-body">
                <div class="donut-box"><canvas id="myChart"></canvas></div>
                <div id="legend-container"></div>
            </div>
            <script src="draw_chart.js"></script>
            {{/javascript}}
            {{^javascript}}
            <div class="chart-container">
                <div class="chart">
                    <div class="chart-inner">
                        <div class="chart-bar" style="width: {{errorPercentage}}%"></div>
                        <div class="chart-bar" style="width: {{warnPercentage}}%"></div>
                        <div class="chart-bar" style="width: {{successPercentage}}%"></div>
                    </div>
                </div>
                <div class="chart-labels">
                    <div class="chart-label">Errors {{errors}}</div>
                    <div class="chart-label">Warnings {{warnings}}</div>
                    <div class="chart-label">Success {{success}}</div>
                </div>
            </div>
            {{/javascript}}
        </div>

        <div class="card-wrapper">
            <div class="s2a-card-top" style="margin-bottom: 6px;">
                <h2 class="action-tag no-top">Run Health &amp; Execution Diagnostics</h2>
            </div>
            <div class="s2a-rows-list">
                <div class="report-detail-row">
                    <span>Run outcome <small class="row-sub-note">({{runStatusDetails}})</small></span>
                    <label class="test-result result-{{runStatusResult}}">{{runStatus}}</label>
                </div>
                <div class="report-detail-row">
                    <span>Quality gate <small class="row-sub-note">({{qualityGateDescription}})</small></span>
                    <label class="test-result result-{{qualityGateResult}}">{{qualityGateStatus}}</label>
                </div>
                <div class="report-detail-row">
                    <span>Execution time / Avg response</span>
                    <strong>{{execution}} · {{averageResponseTime}}ms</strong>
                </div>
                <div class="report-detail-row">
                    <span>Fuzzers / Paths in scope</span>
                    <strong><span class="orange_text">{{fuzzers}}</span>/{{totalFuzzers}} fuzzers · <span class="orange_text">{{paths}}</span>/{{totalPaths}} paths</strong>
                </div>
                <div class="report-detail-row">
                    <span>Authentication errors / I/O errors</span>
                    <strong>{{authErrors}} Auth · {{ioErrors}} I/O</strong>
                </div>
            </div>
        </div>

        <div class="card-wrapper">
            <div class="s2a-card-top" style="margin-bottom: 6px;">
                <h2 class="action-tag no-top">Target, Scope &amp; Reproduction</h2>
            </div>
            <div class="s2a-rows-list">
                <div class="report-detail-row">
                    <span>Base path</span>
                    <strong class="link_text">{{baseUrl}}</strong>
                </div>
                <div class="report-detail-row">
                    <span>Spec file</span>
                    <strong class="link_text">{{contractName}}</strong>
                </div>
                <div class="report-detail-row">
                    <span>Http Methods</span>
                    <div class="methods-inline-wrap">
                        {{#httpMethods}}
                        <span class="active rounded rounded-{{.}}">{{.}}</span>
                        {{/httpMethods}}
                    </div>
                </div>
                <div class="report-detail-row">
                    <span>Runtime resource reuse / Configured stop limits</span>
                    <strong>{{resourceReuseStatus}} · {{#hasStopLimits}}{{#stopLimits}}{{name}}: {{value}}{{suffix}} {{/stopLimits}}{{/hasStopLimits}}{{^hasStopLimits}}None{{/hasStopLimits}}</strong>
                </div>
                <div class="report-detail-row">
                    <span>Random seed</span>
                    <strong class="mono-val">{{randomSeed}}</strong>
                </div>
            </div>
        </div>
    </div>

    {{#hasResponseCodes}}
    <div class="stats-grid">
        <div class="card-wrapper">
            <div class="chart-head-inline">
                <h2 class="action-tag no-top">HTTP Response Codes</h2>
                <div id="response-code-legend-container" class="stats-legend-container"></div>
            </div>
            {{#javascript}}
            <div class="stats-chart-container canvas-box-220">
                <canvas id="responseCodeChart"></canvas>
            </div>
            <script>
                const responseCodeData = [
                    {{#responseCodeDistribution}}
                    {code: {{code}}, count: {{count}}, family: '{{family}}'},
                    {{/responseCodeDistribution}}
                ];
            </script>
            <script src="draw_response_codes_chart.js"></script>
            {{/javascript}}
        </div>
        {{#hasFailingPaths}}
        <div class="card-wrapper">
            <div class="chart-head-inline">
                <h2 class="action-tag no-top">Top Failing Paths</h2>
                <div id="top-failing-paths-legend-container" class="stats-legend-container"></div>
            </div>
            {{#javascript}}
            <div class="stats-chart-container canvas-box-220">
                <canvas id="topFailingPathsChart"></canvas>
            </div>
            <script>
                const topFailingPathsData = [
                    {{#topFailingPaths}}
                    {path: '{{path}}', count: {{count}}},
                    {{/topFailingPaths}}
                ];
            </script>
            <script src="draw_top_failing_paths_chart.js"></script>
            {{/javascript}}
        </div>
        {{/hasFailingPaths}}
    </div>
    {{/hasResponseCodes}}
    <h2 class="title-section">Root-Cause Clusters</h2>

    <div class="cluster-toolbar card-wrapper">
        <div class="cluster-toolbar-left">
            <input type="text" id="clusterSearchInput" class="cluster-search-input"
                   placeholder="Search clusters by path, exception, HTTP status, or fuzzer..."
                   oninput="filterClusters()"/>
            <div class="cluster-filter-group">
                <button type="button" class="cluster-filter-btn active" data-filter="all" onclick="setClusterFilter('all', this)">All</button>
                <button type="button" class="cluster-filter-btn" data-filter="error" onclick="setClusterFilter('error', this)">Errors</button>
                <button type="button" class="cluster-filter-btn" data-filter="warning" onclick="setClusterFilter('warning', this)">Warnings</button>
                <button type="button" class="cluster-filter-btn" data-filter="5xx" onclick="setClusterFilter('5xx', this)">5XX Crashes</button>
            </div>
        </div>
        <div class="cluster-toolbar-right">
            <button type="button" class="cluster-action-btn" onclick="expandAllClusters()">Expand All</button>
            <button type="button" class="cluster-action-btn" onclick="collapseAllClusters()">Collapse All</button>
        </div>
    </div>

    {{#groupedTestCases}}
    <div class="card-wrapper some-margin cluster-reason-group {{severityClass}}" data-severity="{{severityClass}}">
        <div class="error-cluster-header" onclick="toggleErrorCluster(this)">
            <h3 class="error-title">{{resultReason}}</h3>
            <div class="cluster-reason-badges">
                <span class="cluster-badge badge-neutral">{{clusterCount}} root-cause cluster(s)</span>
                {{#hasErrors}}
                <span class="cluster-badge badge-error">{{errorCount}} Errors</span>
                {{/hasErrors}}
                {{#hasWarnings}}
                <span class="cluster-badge badge-warning">{{warningCount}} Warnings</span>
                {{/hasWarnings}}
            </div>
        </div>
        <div class="error-cluster-content">
            <div class="error-cluster-container">
                {{#clusters}}
                <div class="error-card cluster-card-{{severity}}"
                     data-severity="{{severity}}" data-is5xx="{{is5xx}}" data-status="{{httpStatusCode}}">
                    <div class="cluster-title" onclick="toggleCluster(this)">
                        <div class="cluster-title-main">
                            <span class="cluster-id-label">Cluster #{{clusterId}}</span>
                            <span class="cluster-badge {{statusBadgeClass}}">HTTP {{httpStatusCode}}</span>
                            <span class="cluster-badge badge-count">{{testCount}} test(s)</span>
                            <span class="cluster-badge badge-neutral">{{pathCount}} path(s)</span>
                            <span class="cluster-badge badge-neutral">{{fuzzerCount}} fuzzer(s)</span>
                        </div>
                        <div class="cluster-root-cause-summary">{{rootCauseSummary}}</div>
                    </div>
                    <div class="cluster-content">
                        <div class="cluster-meta-row">
                            <strong>Triggered by Fuzzers:</strong> <span class="cluster-fuzzers-list">{{fuzzers}}</span>
                        </div>
                        <details class="cluster-response-details">
                            <summary>Sample Response Body</summary>
                            <pre class="cluster-response-pre">{{errorMessage}}</pre>
                        </details>
                        <div class="cluster-paths-table">
                            {{#paths}}
                            <div class="cluster-path-row">
                                <div class="cluster-path-name">
                                    {{#methods}}<span class="cluster-method-tag">{{methods}}</span>{{/methods}}
                                    <code>{{path}}</code>
                                    <span class="cluster-path-count">({{pathTestCount}})</span>
                                </div>
                                <div class="cluster-path-links">
                                    {{{testCases}}}
                                </div>
                            </div>
                            {{/paths}}
                        </div>
                    </div>
                </div>
                {{/clusters}}
            </div>
        </div>
    </div>
    {{/groupedTestCases}}

    <footer class="cats-funny-footer">
        <span class="footer-quips">You've reached the end of the fuzzing universe — no more endpoints left to torture.</span>
        <span class="footer-sep">·</span>
        <span class="footer-credit">
            Built with
            <span class="coffee-badge" title="Freshly brewed espresso">
                <svg class="coffee-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path class="steam s1" d="M8 5.5C8 4 9.5 3.5 9.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path class="steam s2" d="M12 5.5C12 4 13.5 3.5 13.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path class="steam s3" d="M16 5.5C16 4 17.5 3.5 17.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M5 8.5H17V14.5C17 17.8137 14.3137 20.5 11 20.5C7.68629 20.5 5 17.8137 5 14.5V8.5Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                    <path d="M17 10H18.8C20.2912 10 21.5 11.2088 21.5 12.7C21.5 14.1912 20.2912 15.4 18.8 15.4H17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    <path d="M3.5 20.5H18.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
            </span>
            and curiosity by <a href="https://github.com/Endava/cats" target="_blank" rel="noopener">Madalin Ilie</a>
        </span>
    </footer>
</main>
{{#javascript}}
<script src="script.js"></script>
{{/javascript}}
</body>
</html>
